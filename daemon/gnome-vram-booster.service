[Unit]
Description=GNOME VRAM Booster - dynamic dmem cgroup prioritization for foreground apps
After=dmemcg-booster.service
Requires=dmemcg-booster.service

[Service]
Type=dbus
BusName=org.gnome.VramBooster
ExecStart=/usr/local/bin/gnome-vram-booster
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
